{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniTrax",
  "version": "0.2.0",
  "identifier": "dev.bcnet.anitrax",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniTrax",
        "width": 1280,
        "height": 832,
        "minWidth": 940,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anitrax"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NUUwRjhCQzBFMUY0REUKUldUZTlPSEFpdzllVng5WjJXQ0thcVFBdWVYZDBsRVBVN1FWbTc5djlMOXQxNndmSnBFUkFnc0IK",
      "endpoints": [
        "https://github.com/Vipth/anitrax/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
