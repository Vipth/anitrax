{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the M6a playback-confirm popups",
  "windows": ["main", "playback-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "opener:allow-open-url",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}
